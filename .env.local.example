# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key

# OpenAI Compatible API
OPENAI_API_KEY=your-api-key
OPENAI_API_BASE_URL=https://api.x.ai/v1
OPENAI_MODEL_FAST=grok-4.3
OPENAI_MODEL_AUTO=grok-4.3
OPENAI_MODEL_EXPERT=grok-4.3

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
ENABLE_REGISTRATION=false
CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_MS=60000
